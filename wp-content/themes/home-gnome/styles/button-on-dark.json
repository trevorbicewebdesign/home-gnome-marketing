{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "On dark",
	"slug": "on-dark",
	"blockTypes": [
		"core/button"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		":hover": {
			"color": {
				"background": "var(--wp--preset--color--tertiary)",
				"text": "var(--wp--preset--color--foreground)"
			}
		},
		":focus": {
			"color": {
				"background": "var(--wp--preset--color--tertiary)",
				"text": "var(--wp--preset--color--foreground)"
			}
		}
	}
}
