{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#086B67"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#E88D79"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"color": "#203835"
				},
				{
					"slug": "body",
					"name": "Body",
					"color": "#4E625D"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#FFFCF7"
				},
				{
					"slug": "tertiary",
					"name": "Tertiary",
					"color": "#EAF2ED"
				},
				{
					"slug": "quaternary",
					"name": "Quaternary",
					"color": "#FAE8E2"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#FFFFFF"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#054B48"
				},
				{
					"slug": "outline",
					"name": "Outline",
					"color": "#CBD7D1"
				},
				{
					"slug": "neutral",
					"name": "Neutral",
					"color": "#61706B"
				},
				{
					"slug": "transparent",
					"name": "Transparent",
					"color": "transparent"
				},
				{
					"slug": "currentColor",
					"name": "Current Color",
					"color": "currentColor"
				},
				{
					"slug": "inherit",
					"name": "Inherit",
					"color": "inherit"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"px",
				"%",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "xxx-small",
					"name": "XXX Small (4px)",
					"size": "4px"
				},
				{
					"slug": "xx-small",
					"name": "XX Small (8px)",
					"size": "8px"
				},
				{
					"slug": "x-small",
					"name": "X Small (16px)",
					"size": "16px"
				},
				{
					"slug": "small",
					"name": "Small (24px)",
					"size": "24px"
				},
				{
					"slug": "medium",
					"name": "Medium (32px)",
					"size": "32px"
				},
				{
					"slug": "large",
					"name": "Large (48px)",
					"size": "48px"
				},
				{
					"slug": "x-large",
					"name": "X Large (64px)",
					"size": "64px"
				},
				{
					"slug": "xx-large",
					"name": "XX Large (96px)",
					"size": "96px"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope/manrope-wght.woff2"
							]
						}
					]
				},
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-wght.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "italic",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-wght-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "X Small",
					"size": "14px",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "18px",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "22px",
					"fluid": {
						"min": "20px",
						"max": "22px"
					}
				},
				{
					"slug": "x-large",
					"name": "X Large",
					"size": "28px",
					"fluid": {
						"min": "24px",
						"max": "28px"
					}
				},
				{
					"slug": "xx-large",
					"name": "XX Large",
					"size": "36px",
					"fluid": {
						"min": "28px",
						"max": "36px"
					}
				},
				{
					"slug": "xxx-large",
					"name": "XXX Large",
					"size": "44px",
					"fluid": {
						"min": "32px",
						"max": "44px"
					}
				},
				{
					"slug": "xxxx-large",
					"name": "XXXX Large",
					"size": "64px",
					"fluid": {
						"min": "40px",
						"max": "64px"
					}
				}
			]
		},
		"custom": {
			"font-family": {
				"body": "var(--wp--preset--font-family--dm-sans)",
				"heading": "var(--wp--preset--font-family--manrope)"
			},
			"lineHeight": {
				"initial": 1,
				"hero": 1.1,
				"xxSmall": 1.2,
				"xSmall": 1.3,
				"small": 1.4,
				"medium": 1.5,
				"large": 1.6
			},
			"borderRadius": {
				"xxSmall": "4px",
				"xSmall": "6px",
				"small": "8px",
				"medium": "12px",
				"large": "16px",
				"xLarge": "20px",
				"xxLarge": "24px",
				"full": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--body)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--x-small)",
			"padding": {
				"left": "clamp(var(--wp--preset--spacing--small), 3vw, var(--wp--preset--spacing--medium))",
				"right": "clamp(var(--wp--preset--spacing--small), 3vw, var(--wp--preset--spacing--medium))"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--custom--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--large)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--foreground)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--foreground)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--xx-small)",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--hero)",
					"letterSpacing": "-0.02em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--x-small)"
					}
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--xx-small)",
					"letterSpacing": "-0.015em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--x-small)"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--xx-small)",
					"letterSpacing": "-0.01em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--xx-small)"
					}
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--x-small)",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--xx-small)"
					}
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--x-small)",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--xx-small)"
					}
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--x-small)",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--xx-small)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--small)",
					"textDecoration": "none"
				},
				"border": {
					"radius": "var(--wp--custom--border-radius--x-small)",
					"width": "0",
					"style": "none"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "var(--wp--preset--spacing--small)",
						"right": "var(--wp--preset--spacing--small)"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--foreground)",
						"text": "var(--wp--preset--color--background)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--foreground)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--neutral)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"lineHeight": "var(--wp--custom--line-height--medium)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--small)",
					"letterSpacing": "0"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--custom--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "800",
					"lineHeight": "var(--wp--custom--line-height--x-small)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--heading)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--border-radius--medium)"
				}
			},
			"core/details": {
				"color": {
					"background": "var(--wp--preset--color--surface)"
				},
				"border": {
					"color": "var(--wp--preset--color--outline)",
					"style": "solid",
					"width": "1px",
					"radius": "var(--wp--custom--border-radius--small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--x-small)",
						"bottom": "var(--wp--preset--spacing--x-small)",
						"left": "var(--wp--preset--spacing--x-small)",
						"right": "var(--wp--preset--spacing--x-small)"
					},
					"blockGap": "var(--wp--preset--spacing--xx-small)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--small)"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--heading)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "var(--wp--custom--border-radius--small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--x-small)",
						"bottom": "var(--wp--preset--spacing--x-small)",
						"left": "var(--wp--preset--spacing--small)",
						"right": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--outline)"
				}
			},
			"core/group": {
				"spacing": {
					"padding": {
						"left": "0",
						"right": "0"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing page (sections, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
